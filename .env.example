# Pandora Architect — exemplo de configuração
# Copie para `.env` na raiz do projeto:  cp .env.example .env
# Os scripts (run.sh / dev.sh / run.bat) carregam este arquivo e traduzem
# PANDORA_* para as variáveis que o backend lê (HOST, PORT, DATA_DIR, ...).

# --- Servidor ---------------------------------------------------------------
# Endereço e porta da API (padrão: 127.0.0.1:8000)
PANDORA_HOST=127.0.0.1
PANDORA_PORT=8000

# --- Banco ------------------------------------------------------------------
# Diretório do SQLite e nome do arquivo (padrão: backend/data/pandora.db)
#PANDORA_DATA_DIR=
#PANDORA_DB_FILENAME=pandora.db

# --- CORS -------------------------------------------------------------------
# Origem permitida em desenvolvimento (Vite)
PANDORA_DEV_ORIGIN=http://localhost:5173

# --- Limites de descoberta de arquivos --------------------------------------
#PANDORA_MAX_FILE_SIZE_BYTES=1048576
#PANDORA_MAX_FILES=5000
#PANDORA_MAX_DEPTH=30

# --- Segurança --------------------------------------------------------------
# Lista de diretórios raiz que a API pode ler, separados por os.pathsep
# (":" no Linux/macOS, ";" no Windows). O backend lê esta variável diretamente
# (sem tradução). Sem ela, valem home + cwd do processo.
#PANDORA_ALLOWED_DIRS=/home/usuario/projetos
